# serial_test, a dev-dependency, is the floor.
RUST_MIN_VER="1.93.1"

inherit cargo optfeature

DESCRIPTION="Git plugin for nostr: NIP-34 repos, patches and GRASP hosting"
HOMEPAGE="https://ngit.dev https://gitworkshop.dev/danconwaydev.com/ngit"
# The .crate is a plain tarball; renamed so cargo.eclass unpacks it into
# ${WORKDIR} instead of the vendor directory.
SRC_URI="
	https://crates.io/api/v1/crates/${PN}/${PV}/download -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 BSD-2 BSD CC0-1.0 CDLA-Permissive-2.0 ISC MIT
	MPL-2.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

# libgit2-sys 0.18.x tracks libgit2 1.9.x.
DEPEND="
	>=dev-libs/libgit2-1.9:=
	<dev-libs/libgit2-1.10
	dev-libs/openssl:=
	net-libs/libssh2:=
"
RDEPEND="
	${DEPEND}
	dev-vcs/git
"
BDEPEND="virtual/pkgconfig"

src_configure() {
	export LIBGIT2_NO_VENDOR=1 LIBSSH2_SYS_USE_PKG_CONFIG=1 OPENSSL_NO_VENDOR=1
	cargo_src_configure
}

src_test() {
	# The integration tests need upstream's test_harness workspace member,
	# which isn't published with the crate.
	cargo_src_test --lib --bins
}

pkg_postinst() {
	optfeature "storing nostr keys in the system keyring" virtual/secret-service
}
