rule ASM_COMPILER__RTXrayDSO.2ex86_64_unscanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/lib/llvm/22/bin/clang $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building ASM object $out


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__RTXrayDSO.2ex86_64_unscanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/lib/llvm/22/bin/clang++ $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for linking CXX static library.

rule CXX_STATIC_LIBRARY_LINKER__clang_rt.2exray-dso-x86_64_Release
  command = $PRE_LINK && /usr/sbin/cmake -E rm -f $TARGET_FILE && /usr/lib/llvm/22/bin/llvm-ar Dqc $TARGET_FILE $LINK_FLAGS $in && /usr/lib/llvm/22/bin/llvm-ranlib -D $TARGET_FILE && $POST_BUILD
  description = Linking CXX static library $TARGET_FILE
  restat = $RESTAT


